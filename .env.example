# FilingAgent — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------

# Which provider the four arms and the primary judge run on.
#   groq      (default) — free tier, OpenAI-compatible endpoint
#   anthropic           — alternate implementation, billed per token
# Both are implemented behind src/llm.py; swapping is a config change, not a
# code change. All four arms MUST share one provider and one model — a model
# difference between arms would confound the four-arm comparison (PRD FR3).
LLM_PROVIDER=groq

# --- Groq (default provider) ---
# Free tier, no credit card. https://console.groq.com/keys
# The free tier's hard quota is also what makes FR6.3's public-demo spend cap
# structural: there is no billing relationship to drain.
GROQ_API_KEY=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model used by all four arms. Pin ONE value; verify the exact string against
# Groq's current model list, as free-tier model availability changes.
LLM_MODEL=openai/gpt-oss-120b

# Model used by the primary LLM judge (PRD FR8.5). May differ from LLM_MODEL.
JUDGE_MODEL=openai/gpt-oss-120b

# --- Anthropic (alternate provider) ---
# Only required when LLM_PROVIDER=anthropic.
# https://console.anthropic.com/settings/keys
# NOTE: a Claude Max subscription covers Claude Code, NOT this API — usage here
# is billed separately. Set a provider-side spend limit before deploying.
# Do NOT set temperature/top_p/top_k on this path: they were removed on current
# Claude models and return a 400 (PRD FR8.5).
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5

# --- Cross-model judge (PRD FR8.8) ---
# Second, independent judge used for the inter-judge agreement rate. Runs
# locally via Ollama — a different lab's weights is a stronger independence
# claim than two models from one vendor. Optional: the check is skipped with a
# clear message when unreachable, so CI and a fresh clone never hard-fail.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=llama3.1:8b

# --- SEC EDGAR --------------------------------------------------------------

# EDGAR requires a descriptive User-Agent containing a real contact email, or
# it returns 403. Format: "<app/purpose> <contact email>". Required by
# src/ingest.py and src/xbrl.py for any live fetch (not required to run
# against the committed data/raw/ corpus).
EDGAR_USER_AGENT="FilingAgent research contact@example.com"

# --- Storage ------------------------------------------------------------

# Directory where the Chroma persistent vector store lives. Baked into the
# Docker image at build time (FR6.2) — do not ingest at container boot.
CHROMA_DIR=./chroma_db

# SQLite database file used to persist per-request traces (src/traces.py) and
# the monitoring data backing GET /stats.
TRACE_DB=./traces.sqlite

# --- Public deployment safety (FR6.3) ---------------------------------------

# Hard global cap on the number of /query requests served per calendar day
# across all clients. Once exceeded, /query degrades to a canned response
# instead of calling the LLM provider. Required before the deploy link is
# made public.
DAILY_REQUEST_CAP=200

# Per-IP rate limit, expressed as requests allowed per rolling 60-second
# window. Required before the deploy link is made public.
RATE_LIMIT_PER_MIN=10
