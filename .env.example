# FilingAgent — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------

# Which provider the four arms and the primary judge run on.
#   ollama    (default) — LOCAL inference, no key, no quota, no egress
#   groq                — hosted free tier, but only ~8K tokens/minute
#   gemini              — hosted, 20 requests/DAY on free; needs billing
#   cerebras / zai      — hosted, both required payment when tested
#   anthropic           — different wire format, billed per token
# All are implemented behind src/llm.py; swapping is a config change, not a
# code change. All four arms MUST share one provider and one model — a model
# difference between arms would confound the four-arm comparison (PRD FR3).
LLM_PROVIDER=ollama

# --- Ollama (default) — fully local -----------------------------------------
# Install https://ollama.com, then: ollama pull qwen3:8b
# No API key. No account. No request leaves your machine.
#
# This is the default because every hosted free tier tested fails on this
# workload: one RAG request here is ~9.5K tokens, and a full evaluation is
# ~1M. Groq's 8K/min cannot fit a single call; Gemini's free tier allows 20
# per day. Someone cloning this repo should not have to buy credits to run it.
#
# MODEL CHOICE MATTERS. Three of four arms are tool-calling loops, and small
# models get tool ARGUMENTS wrong even when they correctly decide to call
# something. Measured on the same prompt:
#     llama3.2:3b -> {"ticker":"Microsoft","fiscal_year":"2024"}  (wrong
#                     symbol, year as a string — every lookup returns a Miss)
#     qwen3:8b    -> {"ticker":"MSFT","fiscal_year":2024}         (correct)
# Use an 8B-class model or better, or the tool arms fail for reasons that have
# nothing to do with their design.
#
# If Ollama reports "requires more system memory than is available", cap the
# context — it defaults to the model's full window and the KV cache dominates:
#     setx OLLAMA_CONTEXT_LENGTH 16384       (Windows; restart Ollama after)
#     export OLLAMA_CONTEXT_LENGTH=16384     (macOS/Linux)
# 16384 comfortably fits the ~9.5K-token requests this app makes.
LLM_MODEL=qwen3:8b

# Where Ollama listens. Use host.docker.internal (not localhost) from inside
# a container — see docker-compose.yml.
LLM_BASE_URL=http://localhost:11434/v1

# --- Groq (hosted alternate) ---
# Free tier, no credit card. https://console.groq.com/keys
# ⚠️ Free tier is 8K tokens/MINUTE. One RAG request here measured 9,521
# tokens, so a single call returns 413 before any rate of calls matters. Its
# 200K/day also works out to only ~21 requests at this size.
# Set LLM_PROVIDER=groq and LLM_MODEL=openai/gpt-oss-120b to use it.
#
# Pin ONE model and verify it against the provider's current list before a
# measurement run — a retired ID fails at the worst moment. Two were hit
# during this build: Groq's llama-3.3-70b-versatile and Google's
# gemini-2.0-flash.
GROQ_API_KEY=gsk_your-key-here

# --- Google AI Studio / Gemini (alternate) ---
# https://aistudio.google.com/apikey
#
# ⚠️ The free tier allows **20 requests per DAY** per model
# (GenerateRequestsPerDayPerProjectPerModel-FreeTier). That is not a typo and
# not a per-minute limit. It cannot support a measurement run or a public
# demo — 20 clicks exhausts the day. Usable only with billing enabled.
#
# Also note, if you enable it: Gemini 3.x is a thinking model and attaches a
# `thought_signature` to each tool call that MUST be echoed back on the next
# turn, or multi-turn tool calling fails with a 400. src/llm.py handles this
# by passing the provider's own message object through untouched.
GEMINI_API_KEY=your-gemini-key-here

# --- Any other OpenAI-compatible endpoint ---
# Overrides the selected provider's default base URL, so a self-hosted vLLM,
# Ollama's /v1 shim, Cerebras, OpenRouter, or a proxy needs no code change.
# Leave unset to take the provider's default.
# LLM_BASE_URL=https://api.example.com/v1

# Model used by the primary LLM judge (PRD FR8.5). May differ from LLM_MODEL —
# FR8.8's cross-model agreement check deliberately wants a second opinion from
# different weights.
JUDGE_MODEL=openai/gpt-oss-120b

# --- Anthropic (alternate provider) ---
# Only required when LLM_PROVIDER=anthropic.
# https://console.anthropic.com/settings/keys
# NOTE: a Claude Max subscription covers Claude Code, NOT this API — usage here
# is billed separately. Set a provider-side spend limit before deploying.
# Do NOT set temperature/top_p/top_k on this path: they were removed on current
# Claude models and return a 400 (PRD FR8.5).
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5

# --- Cross-model judge (PRD FR8.8) ---
# Second, independent judge used for the inter-judge agreement rate. Runs
# locally via Ollama — a different lab's weights is a stronger independence
# claim than two models from one vendor. Optional: the check is skipped with a
# clear message when unreachable, so CI and a fresh clone never hard-fail.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=llama3.1:8b

# --- SEC EDGAR --------------------------------------------------------------

# EDGAR requires a descriptive User-Agent containing a real contact email, or
# it returns 403. Format: "<app/purpose> <contact email>". Required by
# src/ingest.py and src/xbrl.py for any live fetch (not required to run
# against the committed data/raw/ corpus).
EDGAR_USER_AGENT="FilingAgent research contact@example.com"

# --- Storage ------------------------------------------------------------

# Directory where the Chroma persistent vector store lives. Baked into the
# Docker image at build time (FR6.2) — do not ingest at container boot.
CHROMA_DIR=./chroma_db

# SQLite database file used to persist per-request traces (src/traces.py) and
# the monitoring data backing GET /stats.
TRACE_DB=./traces.sqlite

# --- Public deployment safety (FR6.3) ---------------------------------------

# Hard global cap on the number of /query requests served per calendar day
# across all clients. Once exceeded, /query degrades to a canned response
# instead of calling the LLM provider. Required before the deploy link is
# made public.
DAILY_REQUEST_CAP=200

# Per-IP rate limit, expressed as requests allowed per rolling 60-second
# window. Required before the deploy link is made public.
RATE_LIMIT_PER_MIN=10
