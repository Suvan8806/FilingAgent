# FilingAgent — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------

# Anthropic API key used by the agent loop, baseline arms, and the LLM judge.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- SEC EDGAR --------------------------------------------------------------

# EDGAR requires a descriptive User-Agent containing a real contact email, or
# it returns 403. Format: "<app/purpose> <contact email>". Required by
# src/ingest.py and src/xbrl.py for any live fetch (not required to run
# against the committed data/raw/ corpus).
EDGAR_USER_AGENT="FilingAgent research contact@example.com"

# --- Storage ------------------------------------------------------------

# Directory where the Chroma persistent vector store lives. Baked into the
# Docker image at build time (FR6.2) — do not ingest at container boot.
CHROMA_DIR=./chroma_db

# SQLite database file used to persist per-request traces (src/traces.py) and
# the monitoring data backing GET /stats.
TRACE_DB=./traces.sqlite

# --- Public deployment safety (FR6.3) ---------------------------------------

# Hard global cap on the number of /query requests served per calendar day
# across all clients. Once exceeded, /query degrades to a canned response
# instead of calling the LLM provider. Required before the deploy link is
# made public.
DAILY_REQUEST_CAP=200

# Per-IP rate limit, expressed as requests allowed per rolling 60-second
# window. Required before the deploy link is made public.
RATE_LIMIT_PER_MIN=10
